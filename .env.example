# Directory containing the module-* directories to document.
MDG_MODULES_DIR=/path/to/magento/app/code/Vendor

# Where generated bundles are written (default: ./output)
#MDG_OUTPUT_DIR=./output

# Label taxonomy (default: ./taxonomy.php, falling back to ./taxonomy.example.php)
#MDG_TAXONOMY=./taxonomy.php

# Derived state
#MDG_LABELS_FILE=./labels.tsv
#MDG_STATUS_FILE=./modules.status.tsv

# DocuHub — https://github.com/nicolasperic/docuhub
DOCS_INGEST_URL=http://localhost:3001/api/docs/ingest
DOCS_INGEST_TOKEN=
